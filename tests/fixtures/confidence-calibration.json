        {"quality": "primary", "origin": "release-notes"},
        {"quality": "primary", "origin": "changelog"}
      ],
      "lifecycle": "active",
      "freshness": "fresh",
      "contradicted": false,
      "expected_score": 0.95
    },
    {
      "name": "three independent origins hit the corroboration cap",
      "sources": [
        {"quality": "primary", "origin": "release-notes"},
        {"quality": "primary", "origin": "changelog"},
        {"quality": "primary", "origin": "incident-review"}
